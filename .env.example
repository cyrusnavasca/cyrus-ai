# Copy to .env and fill in. .env is gitignored - it names real people.
#
#   cp .env.example .env
#
# Quote every value: this file is sourced by the shell, so an unquoted
# parenthesis or space in a group chat name is a syntax error.
#
# Shell scripts source it automatically. For a Modal deploy, set the token in
# the deploy environment instead: modal deploy takes it from the shell.

# Your name as the model should think of itself. Used in the persona system
# prompt at both training and inference time - the two must match, or every
# number silently gets worse.
MY_NAME="Me"

# Which conversations go into the corpus, comma-separated. Substring matches
# against the thread id or the group chat name.
#
# Curate this by hand from `style-ft threads --list`, which ranks every thread
# by how many messages you wrote in it. Worth leaving out: family threads,
# whose register is its own thing ("son", "thanks mom"); club and coursework
# threads, which are logistics rather than voice; and the long tail of
# acquaintances and automated messages - an early eval example turned out to be
# an auto-reply whose reference answer was the single word "urgent".
THREADS_INCLUDE="+14155550123,+14155550124,some group chat,another group chat"

# Excludes win over includes. Needed because includes match substrings: an
# include of "o block" also catches "Lego blocks".
THREADS_EXCLUDE="a substring that would over-match"

# Gates the served chat page. The model writes in one person's voice and was
# trained on their friends' messages, so the URL is not the access control.
STYLE_FT_TOKEN="change-me"
