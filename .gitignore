# Personal message data never gets committed. Only the synthetic export
# fixtures the smoke test runs on are tracked.
data/raw/*
data/interim/*
data/processed/*
data/dummy/*.jsonl
!data/**/.gitkeep

# Run outputs: adapters, predictions, reports.
outputs/

# Resume source material, not part of the project.
docs/implementation-summary.md

# python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/

# models
*.safetensors
*.bin
*.gguf
checkpoints/
adapters/

# Names real contacts: thread list, persona name, serving token.
.env
.DS_Store
